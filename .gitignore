# Codex session metadata
/.agents/
/.codex/

# ROS 2 / CMake build products (including nested vendor workspaces)
build/
install/
log/
**/build/
**/install/
**/log/

# Python products and caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/

# Editor and operating-system files
.vscode/
.idea/
*.swp
*~
.DS_Store
*.blend1

# Regenerable Blender interchange meshes used only while building the manual
# mounting-calibration scene.
/tools/calibration/go2_d1_mount/converted/

# The simulator consumes the OBJ/MTL/PBR exports. Keep the much larger,
# redundant authoring and interchange formats outside this code repository.
/simulation/objects/**/*.blend
!/simulation/objects/bowl/bowl_grasp_annotation.blend
/simulation/objects/**/*.fbx
/simulation/objects/**/*.glb
/simulation/objects/**/*.stl

# Regenerable simulation-to-perception domain-gap reports.
/tools/validation/sim_perception_domain/artifacts/
/runtime/perception_runtime_v1/.runtime_cache/

# Local development-only dataset, training runs and paper-object fine-tuning.
/paper_object_perception/

# Local pointer to an unfinished four-boundary hardware calibration session.
/validation/real_pregrasp_alignment/safe_region_calibration/.active_session
