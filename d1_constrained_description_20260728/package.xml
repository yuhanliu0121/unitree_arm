<?xml version="1.0"?>
<package format="3">
  <name>d1_constrained_description</name>
  <version>1.1.0</version>
  <description>
    Mechanically constrained Unitree D1 ROS 2 description and read-only
    hardware joint-state bridge.
  </description>
  <maintainer email="maintainer@example.com">D1 Calibration Maintainers</maintainer>
  <license>LicenseRef-Unitree-D1-Assets</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
