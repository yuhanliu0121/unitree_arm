<?xml version="1.0"?>
<package format="3">
  <name>d1_workspace_analysis</name>
  <version>0.1.0</version>
  <description>Offline MoveIt workspace analysis tools for the Unitree D1.</description>
  <maintainer email="yuhanliu0813@gmail.com">Yuhan Liu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>d1_manipulation</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <depend>rclcpp</depend>
  <depend>shape_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>d1_constrained_description</exec_depend>
  <exec_depend>d1_moveit_config</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
