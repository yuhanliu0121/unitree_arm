uint8 UNIFORM_JOINT_SPEED=0
uint8 COMMON_ARRIVAL=1

string[] joint_names
float64[] positions
uint8 motion_profile
float64 speed_deg_s

# Optional completion policy for stop-and-look visual corrections.  Normal
# callers leave this false and retain the controller's standard endpoint
# semantics.
bool require_settled_feedback
# FINETUNE-only safety envelope. Once settled, every actual joint position
# must remain inside the start-to-target interval expanded by this margin.
# Under-travel inside that interval is intentionally accepted.
float64 execution_guard_margin_rad
float64 maximum_stable_range_rad
uint32 stable_samples
float64 stable_sample_period_s
---
bool success
string detail
float64 maximum_error_rad
---
float64 maximum_error_rad
