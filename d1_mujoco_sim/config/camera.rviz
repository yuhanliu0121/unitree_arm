Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Wrist RGB
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wrist_camera/color/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Wrist Aligned Depth (Plasma)
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wrist_camera/debug/aligned_depth_plasma
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Wrist Raw Depth (Plasma)
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wrist_camera/debug/depth_plasma
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: Link6
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Height: 900
  Width: 1500
